{
  "name": "Data Science Classroom",
  // Use pre-built image from GHCR for fast startup (~2 min vs ~15 min)
  // Image built by .github/workflows/build-container.yml on push to main
  // If image is unavailable, replace "image" with: "build": { "dockerfile": "Dockerfile" }
  "image": "ghcr.io/utsa-humphries-data-science/ms3313_v2:latest",
  // Container settings
  "overrideCommand": false,
  "updateRemoteUserUID": false,
  // Environment variables
  "containerEnv": {
    "NB_USER": "jovyan",
    "NB_UID": "1000"
  },
  // postCreateCommand runs as jovyan (system packages already installed via Dockerfile)
  // Use ${containerWorkspaceFolder} for dynamic path that works with any repo name
  "postCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/conda_setup.sh || true",
  "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/conda_post_start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        // Python / Jupyter
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.black-formatter",
        "ms-python.flake8",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers",
        // R
        "reditorsupport.r",
        // PostgreSQL client (auto-installed on startup)
        "cweijan.vscode-postgresql-client2",
        // Data / CSV
        "mechatroner.rainbow-csv",
        "janisdd.vscode-edit-csv",
        // Utilities
        "redhat.vscode-yaml",
        "yzhang.markdown-all-in-one",
        "eamodio.gitlens",
        // GitHub Copilot (restricted in settings below)
        "github.copilot",
        "github.copilot-chat"
        // Removed (deprecated / redundant / conflict-prone):
        //   ms-toolsai.jupyter-keymap          -> bundled into ms-toolsai.jupyter
        //   ms-toolsai.vscode-jupyter-cell-tags -> bundled into ms-toolsai.jupyter
        //   ms-toolsai.vscode-jupyter-slideshow -> bundled into ms-toolsai.jupyter
        //   rdebugger.r-debugger               -> unstable on jupyter datascience image
        //   ckolkman.vscode-postgres           -> replaced by cweijan.vscode-postgresql-client2
        //   mtxr.sqltools                      -> redundant with cweijan postgres client
        //   mtxr.sqltools-driver-pg            -> redundant with cweijan postgres client
      ],
      "settings": {
        // === DISABLE SETTINGS SYNC COMPLETELY ===
        // This prevents old/conflicting extensions from being synced
        "settingsSync.enable": false,
        // === UNWANTED EXTENSIONS (do not install these) ===
        // mikhail-arkhipov.r - Old R Tools, requires .NET, conflicts with reditorsupport.r
        "extensions.ignoreRecommendations": true,
        // === AUTO-UPDATE EXTENSIONS ===
        "extensions.autoUpdate": true,
        "extensions.autoCheckUpdates": true,
        // === CORE SETTINGS ===
        "python.defaultInterpreterPath": "/opt/conda/bin/python",
        "python.terminal.activateEnvironment": true,
        "r.rpath": "/opt/conda/bin/R",
        "r.rterm.linux": "/opt/conda/bin/R",
        "r.alwaysUseActiveTerminal": true,
        "r.lsp.promptToInstall": false,
        "r.rterm.option": [],
        "r.bracketedPaste": true,
        "r.lsp.enabled": true,
        "r.lsp.args": [
          "--no-save",
          "--no-restore"
        ],
        // r.debugger removed (rdebugger.r-debugger extension no longer installed)
        // === R INTELLISENSE / AUTOCOMPLETE ===
        "r.session.levelOfObjectDetail": "Detailed",
        "r.plot.useHttpgd": true,
        "[r]": {
          "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
          },
          "editor.suggest.showMethods": true,
          "editor.suggest.showFunctions": true,
          "editor.suggest.showVariables": true,
          "editor.suggest.showKeywords": true,
          "editor.acceptSuggestionOnEnter": "on",
          "editor.suggestOnTriggerCharacters": true,
          "editor.tabCompletion": "on"
        },
        // === NOTEBOOK INTELLISENSE ===
        "notebook.lineNumbers": "on",
        "jupyter.completionTriggerCharacters": [
          "."
        ],
        // Jupyter kernel settings
        "jupyter.kernels.filter": [],
        "files.associations": {
          "*.rmd": "rmd",
          "*.Rmd": "rmd"
        },
        "editor.rulers": [
          80,
          120
        ],
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        },
        "flake8.enabled": true,
        "git.enableSmartCommit": true,
        "git.confirmSync": false,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        // === COPILOT RESTRICTIONS FOR CLASSROOM USE ===
        // Disable Agent Mode completely (all variations of the setting)
        "chat.agent.enabled": false,
        "github.copilot.chat.agent.enabled": false,
        "chat.agentMode.enabled": false,
        // Disable advanced Copilot features that could be used for cheating
        "github.copilot.editor.enableCodeActions": false,
        "github.copilot.nextEditSuggestions.enabled": false,
        "github.copilot.renameSuggestions.triggerAutomatically": false,
        "github.copilot.chat.agent.runTasks": false,
        "github.copilot.chat.codesearch.enabled": false,
        "github.copilot.chat.edits.enabled": false,
        // Disable inline completions if you want students to type code themselves
        // "github.copilot.enable": false,
        "sqltools.connections": [],
        // === POSTGRES CLIENT (cweijan.vscode-postgresql-client2) ===
        // NOTE: this extension does NOT support pre-seeding connections via
        // settings.json (no `defaultConnections` key exists). Students add the
        // connection once via the Database panel using:
        //   Host: localhost   Port: 5432   User: student   Password: (blank)
        //   Database: postgres
        // The values are documented in STUDENT_DATABASE_GUIDE.md.
        "database-client.autoSync": false,
        "database-client.disableSQLCompletion": false,
        // === TERMINAL AND JUPYTER SETTINGS ===
        // Show terminal during setup so students can see progress
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.tabs.showActiveTerminal": "always",
        // Set R as preferred kernel for notebooks (avoids "Select Kernel" prompt)
        "notebook.kernelPicker.type": "mru",
        "jupyter.askForKernelRestart": false,
        // Disable test discovery (not needed for classroom, prevents error popup)
        "python.testing.pytestEnabled": false,
        "python.testing.unittestEnabled": false,
        "testing.autoRun.mode": "off",
        // Welcome page and tour settings
        "workbench.startupEditor": "readme"
      }
    }
  },
  // Open terminal automatically to show setup status
  "waitFor": "onCreateCommand",
  "forwardPorts": [
    8888,
    5432,
    3000,
    8000,
    8080
  ],
  "portsAttributes": {
    "8888": {
      "label": "Jupyter Lab",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    },
    "3000": {
      "label": "Development Server",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "Python Web Server",
      "onAutoForward": "openPreview"
    },
    "8080": {
      "label": "Alternative Web Server",
      "onAutoForward": "openPreview"
    }
  },
  // Use jovyan as the default user after container creation
  "remoteUser": "jovyan",
  "runArgs": [
    "--name=${localWorkspaceFolderBasename}-devcontainer",
    "--hostname=codespace-${localWorkspaceFolderBasename}"
  ],
  "shutdownAction": "stopContainer"
}